# ~/.openclaw/.env — секреты агента. НИКОГДА не коммитьте заполненный файл.

# ── LLM-провайдеры ────────────────────────────────────────────────
# OpenAI-совместимый шлюз (или прямой ключ провайдера)
EXCASH_API_KEY=
EXCASH_API_URL=https://your-gateway.example/v1
# DeepSeek (резервная текстовая модель, работает напрямую)
DEEPSEEK_API_KEY=

# ── Слух (ASR-каскад, addons/multimodal/transcribe.py) ────────────
# локальный GigaAM-сервер (опционально)
GIGAAM_ASR_URL=http://127.0.0.1:8001
# Groq whisper (опционально, быстрый резерв)
GROQ_API_KEY=

# ── Почта (addons/skills/mail) ────────────────────────────────────
# Яндекс: пароль приложения (id.yandex.ru -> безопасность)
YA_EMAIL=
YA_APP_PASSWORD=
# подпись; переносы строк как \n
YA_SIGNATURE=С уважением,\nИмя Фамилия
# Gmail: пароль приложения (myaccount.google.com/apppasswords)
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=
# корпоративный Exchange (addons/exchange-mgz), если нужен
MGZ_USER=
MGZ_PASSWORD=

# ── Календарь iCloud (addons/skills/calendar) ─────────────────────
# пароль приложения: account.apple.com -> Вход и безопасность -> Пароли приложений
APPLE_ID=
APPLE_APP_PASSWORD=
CALDAV_URL=https://caldav.icloud.com

# ── Научный монитор (addons/science-monitor) ──────────────────────
SCIENCE_GMAIL_USER=
SCIENCE_GMAIL_PASSWORD=
# id чата, куда слать алерты (ваш telegram id)
ADMIN_ID=

# ── Генерация картинок (addons/skills/imggen) ─────────────────────
# fal.ai -> Dashboard -> Keys. Формат "id:secret"
FAL_KEY=

# ── Slack (addons/skills/slack) ───────────────────────────────────
# api.slack.com/apps -> Create App -> OAuth & Permissions
# User Token Scopes: channels:history, channels:read, groups:history,
#   groups:read, users:read, search:read  -> Install to Workspace
SLACK_TOKEN=

# ── Разное ────────────────────────────────────────────────────────
# email для вежливых запросов к Unpaywall/NCBI (обязательно по их правилам)
UNPAYWALL_EMAIL=
