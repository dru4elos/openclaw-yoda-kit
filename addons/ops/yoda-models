#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""yoda-models gpt6|excash|excash-flash|deepseek [--no-restart] — переключить модели ОБЕИХ Йод (openclaw, yoda2) и пины кронов.
gpt6:         основная GPT-6 Sol, тяжёлое — Astra, рутина — Luna 6 (решение доктора 23.09).
excash:       основная GPT-6 Astra (272k), резервы Astra 1M → Luna 1M → DeepSeek V4.1 Flash (RouterAI) → Gemini.
excash-flash: основная Gemini 3.8 Flash, резервы Luna 1M → DeepSeek V4.1 Flash (RouterAI) → Gemini 3.7.
              Astra из цепочки убрана: с 16.09 отвечает 500. Дозор напишет, когда оживёт.
deepseek:     ВСЯ Йода на DeepSeek V4.1 Flash через RouterAI (1M контекста, картинки, оплата в рублях),
              резерв — Gemini 3.8 Flash. Рассуждения выключены (в чате включаются командой /think).
Ключ RouterAI ставится отдельно и вводится владельцем: sudo yoda-key routerai.
Обе команды правят openclaw.json обеих Йод, пины кронов и перезапускают шлюзы (~1 мин).
--only openclaw|yoda2 — только одну Йоду: у доктора и Маши могут быть разные модели."""
import json, os, pwd, re, subprocess, sys, time

# DeepSeek V4.1 Flash берём у RouterAI (рубли, оплата из России). Прямой api.deepseek.com
# с 17.09 отвечает 402: баланс кончился, а пополнять его из России неудобно.
DS = "routerai/deepseek/deepseek-v4.1-flash"

PROFILES = {
    # 272k-Astra вдвое дешевле 1M (50 ₽/M против 100) и заставляет сжимать историю около 200k;
    # 1M — первый резерв на переполнение и пин утреннего брифа. Heartbeat — на flash в лёгком режиме.
    # 23.09 решение доктора — роли по GPT-6: Sol делает основную работу, Astra — тяжёлые расчёты
    # (подключается сама как резерв и по команде /astra), Luna — рутина: пульс, сжатие памяти,
    # вечерний дайджест. Luna 6 отвечает за 1–2 с, Sol за 2–3 с, Astra за 8–11 с (замер 23.09).
    "gpt6": {"primary": "excash/gpt-6-sol",
             "fallbacks": ["excash/gpt-6-sol-1m", "excash/gpt-6-astra", "excash/gpt-6-luna-1m", DS,
                           "excash/gemini-3.8-flash"],
             "cheap": "excash/gpt-6-luna", "brief": "excash/gpt-6-sol-1m", "heartbeat": "excash/gpt-6-luna",
             "subagents": {"primary": "excash/gpt-6-sol", "fallbacks": ["excash/gpt-6-luna-1m", DS]},
             "think": "adaptive"},
    "excash": {"primary": "excash/gpt-6-astra",
               # 16.09: sol-1m отвечал ошибкой 36 из 36 раз; gemini-3.8-flash на «перегружен» (529) обрывает ход,
               # а не уходит к следующему резерву — поэтому чужой провайдер раньше Gemini
               "fallbacks": ["excash/gpt-6-astra-1m", "excash/gpt-6-luna-1m", DS,
                             "excash/gemini-3.8-flash", "excash/gemini-3.7-flash-tiered"],
               "cheap": "excash/gemini-3.8-flash", "brief": "excash/gpt-6-astra-1m", "heartbeat": "excash/gemini-3.8-flash",
               # субагенты по умолчанию — Luna 1M (рассуждает); для поиска/сбора источников Astra сама запускает
               # sessions_spawn с DeepSeek V4.1 Flash и thinking off (241 ток/с против 58, в разы дешевле) —
               # правило в AGENTS.md «💸 Модели». Он же резерв, если Luna недоступна.
               "subagents": {"primary": "excash/gpt-6-luna-1m", "fallbacks": [DS]},
               "think": "adaptive"},
    # excash-flash: основная — Gemini 3.8 Flash. На случай, когда GPT-6 Astra на excash сбоит
    # (16–17.09 отвечала 500 «internal error»).
    # 17.09: Astra и Astra 1M убраны из цепочки совсем — они лежали сутки, а каждая попытка
    # стоила владельцу 20–60 с ожидания. Дозор напишет, когда оживут: sudo yoda-models excash.
    # Третьим стоит DeepSeek через RouterAI: это ДРУГОЙ провайдер, поэтому когда excash отдаёт
    # 504/500 целиком (как 17.09 в 21:24), ход не обрывается, а доигрывается на нём.
    "excash-flash": {"primary": "excash/gemini-3.8-flash",
                     "fallbacks": ["excash/gpt-6-luna-1m", DS, "excash/gemini-3.7-flash-tiered"],
                     "cheap": "excash/gemini-3.8-flash", "brief": "excash/gpt-6-luna-1m",
                     "heartbeat": "excash/gemini-3.8-flash",
                     "subagents": {"primary": "excash/gpt-6-luna-1m", "fallbacks": ["excash/gemini-3.8-flash", DS]},
                     "think": "adaptive"},
    # ВСЯ Йода на DeepSeek V4.1 Flash через RouterAI (рубли, российская оплата): 1M контекста,
    # картинки, дёшево. Когда excash лежит целиком или хочется сэкономить.
    # Рассуждения выключены: с ними V4.1 Flash тратит 5–11 тыс. токенов и 20–45 с на простую реплику
    # (в чате включается командой /think).
    "deepseek": {"primary": DS, "fallbacks": ["excash/gemini-3.8-flash"],
                 "cheap": DS, "brief": DS, "heartbeat": DS,
                 "subagents": DS, "subthink": "off", "think": "off"},
}

CRON_PINS = {"openclaw": {"Утренний брифинг": "brief", "Вечерний дайджест": "cheap"}}   # по началу имени крона


def run_as(user, cmd):
    return subprocess.run(["su", "-", user, "-c", "source ~/.nvm/nvm.sh >/dev/null 2>&1; " + cmd],
                          capture_output=True, text=True, timeout=300)


def patch(user, prof):
    home = pwd.getpwnam(user).pw_dir
    c = f"{home}/.openclaw/openclaw.json"
    cfg = json.load(open(c, encoding="utf-8"))
    os.replace(c, f"{c}.pre-models.{int(time.time())}") if False else None
    open(f"{c}.pre-models.{int(time.time())}", "w", encoding="utf-8").write(json.dumps(cfg, ensure_ascii=False, indent=2))
    known = set(cfg.get("models", {}).get("providers", {}))
    def live(ref):
        """Отбрасывает модели неподключённого провайдера: одна такая ссылка валит весь конфиг."""
        if isinstance(ref, str) and "/" in ref and ref.split("/")[0] not in known:
            print(f"  ⚠️ {user}: провайдер «{ref.split('/')[0]}» не подключён — пропускаю {ref}"
                  " (подключить: sudo yoda-key routerai)")
            return False
        return True

    d = cfg["agents"]["defaults"]
    chain = [m for m in ([prof["primary"]] + prof["fallbacks"]) if live(m)]
    if not chain:
        sys.exit(f"!! у {user} не осталось ни одной доступной модели — конфиг не тронут")
    d["model"] = {"primary": chain[0], "fallbacks": chain[1:]}
    if prof.get("think"):
        d["thinkingDefault"] = prof["think"]   # deepseek: off (рассуждения V4.1 Flash медленные и дорогие на простых репликах)
    if isinstance(d.get("subagents"), dict):
        sub = prof.get("subagents", prof["cheap"])
        if isinstance(sub, dict):
            subchain = [m for m in ([sub["primary"]] + sub.get("fallbacks", [])) if live(m)]
            sub = {"primary": subchain[0], "fallbacks": subchain[1:]} if subchain else prof["cheap"]
        elif not live(sub):
            sub = prof["cheap"]
        d["subagents"]["model"] = sub
        if prof.get("subthink"):
            d["subagents"]["thinking"] = prof["subthink"]   # off: у DeepSeek рассуждения съедают 5-11 тыс. токенов и 20-45 с
        else:
            d["subagents"].pop("thinking", None)
    if isinstance(d.get("compaction"), dict) and "model" in d["compaction"]:
        d["compaction"]["model"] = prof["cheap"]
    if isinstance(d.get("compaction", {}).get("memoryFlush"), dict) and "model" in d["compaction"]["memoryFlush"]:
        d["compaction"]["memoryFlush"]["model"] = prof["cheap"]
    am = cfg.get("plugins", {}).get("entries", {}).get("active-memory", {}).get("config", {})
    if "model" in am:
        am["model"] = prof["cheap"]
    for k in ("cheap", "brief", "heartbeat"):
        if not live(prof[k]):
            prof = dict(prof, **{k: "excash/gemini-3.8-flash"})
    hb = d.setdefault("heartbeat", {})
    if isinstance(hb, dict):
        hb["model"] = prof["heartbeat"]
        hb["lightContext"] = True            # лёгкий бутстрап
        hb["isolatedSession"] = True         # свежая сессия на каждый пульс: main-сессия таскала ~90k токенов × 48 раз в день
        hb["every"] = "1h"                   # «лёгкий» бутстрап всё равно ~60k (правила+память) × 3 вызова — раз в час хватает
    json.dump(cfg, open(c, "w", encoding="utf-8"), ensure_ascii=False, indent=2)
    uid, gid = pwd.getpwnam(user).pw_uid, pwd.getpwnam(user).pw_gid
    os.chown(c, uid, gid)
    r = run_as(user, "openclaw config validate 2>&1 | tail -1")
    print(f"  {user}: {d['model']['primary']} | {r.stdout.strip()}")
    if "valid" not in r.stdout.lower():
        sys.exit(f"!! конфиг {user} невалиден — рестарта не будет")


def main():
    if len(sys.argv) < 2 or sys.argv[1] not in PROFILES:
        sys.exit(__doc__)
    prof = PROFILES[sys.argv[1]]
    users = ("openclaw", "yoda2")
    if "--only" in sys.argv:
        who = sys.argv[sys.argv.index("--only") + 1]
        if who not in users:
            sys.exit(f"--only: openclaw или yoda2, а не {who}")
        users = (who,)
    for user in users:
        patch(user, prof)
        pins = CRON_PINS.get(user, {})
        if pins:
            lst = run_as(user, "openclaw cron list --json 2>/dev/null").stdout
            try:
                jobs = json.loads(lst); jobs = jobs if isinstance(jobs, list) else jobs.get("jobs", [])
            except Exception:
                jobs = []
            for j in jobs:
                for prefix, kind in pins.items():
                    if str(j.get("name", "")).startswith(prefix):
                        # 17.09: здесь стоял «| tail -1» — код возврата брался у tail, и ЛЮБАЯ ошибка
                        # печаталась как ok. Утренний бриф остался на мёртвой Astra 1M и упал в 08:00.
                        r = run_as(user, f"openclaw cron edit {j['id']} --model {prof[kind]}")
                        out = (r.stdout + r.stderr).strip()
                        ok = r.returncode == 0          # правду скажет сверка ниже, а не текст ответа
                        tail = (out.splitlines() or [""])[-1][:120]
                        print(f"  крон «{j['name'][:22]}» → {prof[kind]}: {'ok' if ok else 'ОШИБКА ' + tail}")
            lst2 = run_as(user, "openclaw cron list --json 2>/dev/null").stdout
            try:
                jobs2 = json.loads(lst2); jobs2 = jobs2 if isinstance(jobs2, list) else jobs2.get("jobs", [])
            except Exception:
                jobs2 = []
            bad = []
            for j in jobs2:                                  # сверка по факту, а не по коду возврата
                for prefix, kind in pins.items():
                    if str(j.get("name", "")).startswith(prefix):
                        m = re.search(r'"model"\s*:\s*"([^"]+)"', json.dumps(j, ensure_ascii=False))
                        got = m.group(1) if m else "по умолчанию"
                        if got != prof[kind]:
                            bad.append(f"«{j['name'][:30]}» стоит {got}, ожидалось {prof[kind]}")
            for b in bad:
                print("  ⚠️ пин НЕ применился:", b)
            if not bad:
                print(f"  пины кронов {user}: сверены, в порядке")
    if "--no-restart" in sys.argv:
        return
    # 22.09: перезапуск шлюза гасит всё, что запущено изнутри Йоды, включая ffmpeg записи эфира
    if subprocess.run(["pgrep", "-x", "ffmpeg"], capture_output=True).returncode == 0:
        print("  ⚠️ идёт запись эфира — шлюзы НЕ перезапускаю, иначе запись оборвётся. Повтори после эфира.")
        return
    for user in users:
        subprocess.run(["su", "-", user, "-c", "XDG_RUNTIME_DIR=/run/user/$(id -u) systemctl --user restart openclaw-gateway"])
    for _ in range(40):
        time.sleep(3)
        s = subprocess.run(["ss", "-ltn"], capture_output=True, text=True).stdout
        want = [p for u, p in (("openclaw", ":18789 "), ("yoda2", ":18790 ")) if u in users]
        if all(p in s for p in want):
            break
    print("  гейтвеи перезапущены, порты слушают:", ":18789 " in s, ":18790 " in s)


if __name__ == "__main__":
    main()
