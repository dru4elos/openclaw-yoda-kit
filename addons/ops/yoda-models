#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""yoda-models excash|deepseek [--no-restart] — переключить модели ОБОИХ Йод (openclaw, yoda2) и пины кронов.
excash: основная gpt-6-astra (272k), резервы astra-1m → sol-1m → gemini-3.8-flash → … → DeepSeek V4.1 Flash;
        дешёвое — gemini-3.8-flash, субагенты — Luna 1M.
deepseek: ВСЯ Йода на DeepSeek V4.1 Flash (id deepseek-flash: 1M контекста, 240 ток/с, картинки, ~10-20× дешевле
        Astra за счёт кэша префикса). Когда excash лежит/ключ отозван или хочется сэкономить. Ничего из excash
        в цепочке (чтобы не ловить бан IP). Рассуждения выключены (thinkingDefault off): с ними DeepSeek тратит
        5-11 тыс. токенов и 20-45 с на простой ответ; в чате можно включить командой /think.
Обратно: sudo yoda-models excash. Обе команды: правят openclaw.json обеих Йод, пины кронов, перезапускают шлюзы (~1 мин)."""
import json, os, pwd, subprocess, sys, time

PROFILES = {
    # 272k-Astra вдвое дешевле 1M (50 ₽/M против 100) и заставляет сжимать историю около 200k;
    # 1M — первый резерв на переполнение и пин утреннего брифа. Heartbeat — на flash в лёгком режиме.
    "excash": {"primary": "excash/gpt-6-astra",
               "fallbacks": ["excash/gpt-6-astra-1m", "excash/gpt-5.6-sol-1m", "excash/gemini-3.8-flash",
                             "excash/gpt-5.6-sol-1m-fast", "excash/gemini-3.7-flash-tiered", "dseek/deepseek-flash"],
               "cheap": "excash/gemini-3.8-flash", "brief": "excash/gpt-6-astra-1m", "heartbeat": "excash/gemini-3.8-flash",
               "subagents": "excash/gpt-5.6-luna-1m", "think": "adaptive"},   # субагенты: Luna 1M (рассуждает, 1M контекста) — по наблюдениям из практики лучше на многошаговых задачах; Spark — конвейеры
    # deepseek-v4-pro с 14.09.2026 сам перенаправляется на V4.1 Flash — отдельной «про» больше нет
    "deepseek": {"primary": "dseek/deepseek-flash", "fallbacks": [],
                 "cheap": "dseek/deepseek-flash", "brief": "dseek/deepseek-flash", "heartbeat": "dseek/deepseek-flash",
                 "subagents": "dseek/deepseek-flash", "think": "off"},
}
CRON_PINS = {"openclaw": {"Утренний брифинг": "brief", "Вечерний дайджест": "cheap"}}   # по началу имени крона


def run_as(user, cmd):
    return subprocess.run(["su", "-", user, "-c", "source ~/.nvm/nvm.sh >/dev/null 2>&1; " + cmd],
                          capture_output=True, text=True, timeout=300)


def patch(user, prof):
    home = pwd.getpwnam(user).pw_dir
    c = f"{home}/.openclaw/openclaw.json"
    cfg = json.load(open(c, encoding="utf-8"))
    os.replace(c, f"{c}.pre-models.{int(time.time())}") if False else None
    open(f"{c}.pre-models.{int(time.time())}", "w", encoding="utf-8").write(json.dumps(cfg, ensure_ascii=False, indent=2))
    d = cfg["agents"]["defaults"]
    d["model"] = {"primary": prof["primary"], "fallbacks": prof["fallbacks"]}
    if prof.get("think"):
        d["thinkingDefault"] = prof["think"]   # deepseek: off (рассуждения V4.1 Flash медленные и дорогие на простых репликах)
    if isinstance(d.get("subagents"), dict):
        d["subagents"]["model"] = prof.get("subagents", prof["cheap"])
    if isinstance(d.get("compaction"), dict) and "model" in d["compaction"]:
        d["compaction"]["model"] = prof["cheap"]
    if isinstance(d.get("compaction", {}).get("memoryFlush"), dict) and "model" in d["compaction"]["memoryFlush"]:
        d["compaction"]["memoryFlush"]["model"] = prof["cheap"]
    am = cfg.get("plugins", {}).get("entries", {}).get("active-memory", {}).get("config", {})
    if "model" in am:
        am["model"] = prof["cheap"]
    hb = d.setdefault("heartbeat", {})
    if isinstance(hb, dict):
        hb["model"] = prof["heartbeat"]
        hb["lightContext"] = True            # лёгкий бутстрап
        hb["isolatedSession"] = True         # свежая сессия на каждый пульс: main-сессия таскала ~90k токенов × 48 раз в день
        hb["every"] = "1h"                   # «лёгкий» бутстрап всё равно ~60k (правила+память) × 3 вызова — раз в час хватает
    json.dump(cfg, open(c, "w", encoding="utf-8"), ensure_ascii=False, indent=2)
    uid, gid = pwd.getpwnam(user).pw_uid, pwd.getpwnam(user).pw_gid
    os.chown(c, uid, gid)
    r = run_as(user, "openclaw config validate 2>&1 | tail -1")
    print(f"  {user}: {prof['primary']} | {r.stdout.strip()}")
    if "valid" not in r.stdout.lower():
        sys.exit(f"!! конфиг {user} невалиден — рестарта не будет")


def main():
    if len(sys.argv) < 2 or sys.argv[1] not in PROFILES:
        sys.exit(__doc__)
    prof = PROFILES[sys.argv[1]]
    for user in ("openclaw", "yoda2"):
        patch(user, prof)
        pins = CRON_PINS.get(user, {})
        if pins:
            lst = run_as(user, "openclaw cron list --json 2>/dev/null").stdout
            try:
                jobs = json.loads(lst); jobs = jobs if isinstance(jobs, list) else jobs.get("jobs", [])
            except Exception:
                jobs = []
            for j in jobs:
                for prefix, kind in pins.items():
                    if str(j.get("name", "")).startswith(prefix):
                        r = run_as(user, f"openclaw cron edit {j['id']} --model {prof[kind]} 2>&1 | tail -1")
                        print(f"  крон «{j['name'][:22]}» → {prof[kind]}: {'ok' if r.returncode == 0 else r.stdout[-100:]}")
    if "--no-restart" in sys.argv:
        return
    for user in ("openclaw", "yoda2"):
        subprocess.run(["su", "-", user, "-c", "XDG_RUNTIME_DIR=/run/user/$(id -u) systemctl --user restart openclaw-gateway"])
    for _ in range(40):
        time.sleep(3)
        s = subprocess.run(["ss", "-ltn"], capture_output=True, text=True).stdout
        if ":18789 " in s and ":18790 " in s:
            break
    print("  гейтвеи перезапущены, порты слушают:", ":18789 " in s, ":18790 " in s)


if __name__ == "__main__":
    main()
