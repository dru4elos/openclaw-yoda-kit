#!/usr/bin/python3
# -*- coding: utf-8 -*-
"""Живой список моделей: раз в полчаса пробуем каждую и пишем, кто отвечает.

Зачем. 17.09 в webinar.py, sci_brief.py и yoda_tg.py первой в списке стояла
codex-spark, потерявшая доступ ещё 16.09: 194 отказа за сутки, и каждый съедал
попытку перед уходом на живую модель. Списков было три, руками их никто не
правил. Теперь список один, и он обновляется сам.

Пишет /home/openclaw/.openclaw/models_live.json:
  fast — живые, отсортированы по скорости (чистка кусков, письма, ранжирование)
  long — живые с контекстом 1M (сводка эфира целиком, большие разборы)
  dead — кто не ответил и почему (для дозора и объяснений владельцу)
  catalog — весь список моделей, открытых нашему ключу: появилась новая (01.10 ждём
            Gemini 4) — владельцу уходит сообщение через tome, один раз
Потребители читают файл, а при его отсутствии берут свой запасной список.
"""
import datetime as dt
import json
import os
import re
import shlex
import subprocess
import time
import urllib.error
import urllib.request

ENV = "/home/openclaw/.openclaw/.env"
OUT = "/home/openclaw/.openclaw/models_live.json"
GUARD = "http://127.0.0.1:8788/chat/completions"   # страж-прокси: он же ловит «200 с ошибкой в потоке»
MSK = dt.timezone(dt.timedelta(hours=3))

# (модель, годится ли для длинного контекста). Порядок здесь не важен — решает замер.
CANDIDATES = [
    ("gpt-6.1-sol", False),
    ("gpt-6.1-sol-1m", True),
    ("gpt-6-sol", False),
    ("gpt-6-sol-1m", True),
    ("gpt-6-luna", False),
    ("gpt-6-luna-1m", True),
    ("gemini-3.8-flash", False),
    ("gpt-5.6-luna-1m", True),
    ("gpt-6-astra", False),
    ("gpt-6-astra-1m", True),
    ("gemini-3.7-flash-tiered", False),
    ("gpt-5.3-codex-spark", False),
    ("gpt-5.6-sol-1m", True),
]
# Запасной список на случай, если проба не прошла совсем (нет сети, лежит страж).
SAFE_FAST = ["gpt-6-luna", "gemini-3.8-flash"]
SAFE_LONG = ["gpt-6-luna-1m", "gpt-6.1-sol-1m", "gpt-6-sol-1m"]


def env(name):
    try:
        m = re.search(rf"^{name}=(.*)$", open(ENV, encoding="utf-8").read(), re.M)
        return m.group(1).strip().strip('"').strip("'") if m else ""
    except Exception:
        return ""


def probe(model, key, timeout=60):
    """Возвращает (секунды, "") если ответила, иначе (None, причина)."""
    body = {"model": model, "messages": [{"role": "user", "content": "ok?"}], "max_tokens": 5}
    req = urllib.request.Request(
        GUARD, data=json.dumps(body).encode(),
        headers={"Authorization": "Bearer " + key, "Content-Type": "application/json"})
    t0 = time.time()
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            r.read()
        return round(time.time() - t0, 1), ""
    except urllib.error.HTTPError as e:
        return None, f"HTTP {e.code}"
    except Exception as e:
        return None, type(e).__name__


def catalog(key):
    """Все id моделей, которые excash открывает нашему ключу; None, если список не получен."""
    base = env("EXCASH_API_URL")
    if not base:
        return None
    url = base.rstrip("/") + "/models"
    try:
        req = urllib.request.Request(url, headers={"Authorization": "Bearer " + key})
        with urllib.request.urlopen(req, timeout=30) as r:
            return sorted({m["id"] for m in json.load(r).get("data", []) if m.get("id")})
    except Exception:
        return None


def tell_owner(text):
    cmd = "~/mailvenv/bin/python ~/.openclaw/workspace/skills/tome/tome.py msg " + shlex.quote(text)
    subprocess.run(["su", "-", "openclaw", "-c", cmd], capture_output=True, timeout=60)


def main():
    key = env("EXCASH_API_KEY")
    if not key:
        raise SystemExit("нет EXCASH_API_KEY в " + ENV)
    ok, dead = {}, {}
    long_ok = set()
    for model, is_long in CANDIDATES:
        sec, why = probe(model, key)
        if sec is None:
            dead[model] = why
        else:
            ok[model] = sec
            if is_long:
                long_ok.add(model)
    try:
        prev = json.load(open(OUT, encoding="utf-8")).get("catalog")
    except Exception:
        prev = None
    cat = catalog(key)
    if cat is None:
        cat = prev                     # список не получен — помним старый, чтобы не объявить всё «новым»
    elif prev:
        new = [m for m in cat if m not in prev]
        if new:
            star = [m for m in new if m.startswith("gemini-4")]
            tell_owner(("🆕 В excash появилась Gemini 4: " + ", ".join(star) + ". Скажи Claude — переключим.\n"
                        if star else "") + "🆕 Новые модели в excash: " + ", ".join(new))
    fast = sorted(ok, key=lambda m: ok[m])
    long = sorted(long_ok, key=lambda m: ok[m])
    data = {
        "checked": dt.datetime.now(MSK).isoformat(timespec="seconds"),
        "fast": fast or SAFE_FAST,
        "long": long or [m for m in fast if m] or SAFE_LONG,
        "dead": dead,
        "sec": ok,
        "catalog": cat,
    }
    tmp = OUT + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=1)
    os.replace(tmp, OUT)          # замена целиком: читатель никогда не увидит полфайла
    os.chmod(OUT, 0o644)          # читают обе Йоды
    print(f"живые: {', '.join(f'{m} {ok[m]}с' for m in fast) or '—'}")
    print(f"длинный контекст: {', '.join(long) or '—'}")
    print(f"мёртвые: {', '.join(f'{m} ({w})' for m, w in dead.items()) or '—'}")


if __name__ == "__main__":
    main()
