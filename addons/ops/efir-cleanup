#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Порядок в папке эфиров (правило доктора 24.09): конспект доставлен → промежуточные файлы
удаляются сразу; полное видео живёт 30 дней; тексты, план и журнал хранятся всегда.

    efir-cleanup                 пройти по всем эфирам
    efir-cleanup --out ПАПКА     только один эфир (зовёт webinar.py после доставки)
    efir-cleanup --dry-run       показать, что удалилось бы

Почему так: 24.09 диск дошёл до 97 %, семь эфиров занимали 7,8 ГБ, из них 5,2 ГБ — сегменты
записи, wav и куски для расшифровки, которые после конспекта никому не нужны.
"""
import argparse
import datetime as dt
import glob
import json
import os
import shutil
import sys

ROOT = os.path.expanduser("~/.openclaw/workspace/Эфиры")
KEEP_VIDEO_DAYS = 30
LOG = os.path.join(ROOT, "cleanup.log")


def delivered(d):
    try:
        s = json.load(open(os.path.join(d, "state.json"), encoding="utf-8"))
    except Exception:
        return False
    return bool(s.get("delivered_at") or s.get("summary_sent"))


def size(p):
    if os.path.isdir(p):
        return sum(os.path.getsize(os.path.join(r, f)) for r, _d, fs in os.walk(p) for f in fs)
    return os.path.getsize(p) if os.path.exists(p) else 0


def clean(d, dry):
    """Возвращает (освобождено байт, список удалённого)."""
    freed, gone = 0, []
    if not delivered(d):
        return 0, []                      # конспекта ещё нет — всё нужно для обработки
    full = glob.glob(os.path.join(d, "*_full.mp4"))
    if not full:
        return 0, []                      # полного видео нет — сегменты и есть запись, не трогаем
    victims = [p for p in glob.glob(os.path.join(d, "*_20[0-9][0-9]*.mp4"))]
    victims += [os.path.join(d, n) for n in ("audio_16k.wav", ".concat.txt") if os.path.exists(os.path.join(d, n))]
    victims += [p for p in (os.path.join(d, "chunks"),) if os.path.isdir(p)]
    for f in full:
        age = (dt.datetime.now() - dt.datetime.fromtimestamp(os.path.getmtime(f))).days
        if age > KEEP_VIDEO_DAYS:
            victims.append(f)
    for v in victims:
        freed += size(v)
        gone.append(os.path.relpath(v, ROOT))
        if not dry:
            shutil.rmtree(v) if os.path.isdir(v) else os.remove(v)
    return freed, gone


def main():
    a = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    a.add_argument("--out"); a.add_argument("--dry-run", action="store_true")
    a = a.parse_args()
    dirs = [os.path.abspath(a.out)] if a.out else sorted(glob.glob(os.path.join(ROOT, "20*")))
    total, lines = 0, []
    for d in dirs:
        if not os.path.isdir(d) or os.path.basename(d).startswith("_"):
            continue
        freed, gone = clean(d, a.dry_run)
        if gone:
            total += freed
            lines.append(f"{os.path.basename(d)}: −{freed / 2**20:.0f} МБ ({len(gone)} объектов)")
    stamp = dt.datetime.now().strftime("%Y-%m-%d %H:%M")
    msg = f"{stamp} {'(проверка) ' if a.dry_run else ''}освобождено {total / 2**20:.0f} МБ" + (": " + "; ".join(lines) if lines else "")
    print(msg)
    if not a.dry_run and lines:
        open(LOG, "a", encoding="utf-8").write(msg + "\n")


if __name__ == "__main__":
    main()
